# EAS CLI reads this file at the git root and ignores .gitignore.
# Keep store builds small: only the Expo app, not the website, docs, or API.

# --- rest of this repo ---
/JOSCITY/
/New_Joscity/
/.cursor/
COMPLIANCE_REPORT.md
IOS_APP_STORE.md
PLAY_CONSOLE_README.md
req.md
scalability.md
LICENSE

# --- mobile: same as mobile/.gitignore ---
/mobile/node_modules/
/mobile/.expo/
/mobile/dist/
/mobile/web-build/
/mobile/.tmp-bundle/
/mobile/expo-env.d.ts
/mobile/.kotlin/
