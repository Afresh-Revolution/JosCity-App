{
  "expo": {
    "name": "JosCity",
    "slug": "joscity",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "joscity",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C3D26"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joscity.app",
      "buildNumber": "3",
      "backgroundColor": "#0C3D26",
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": ["TAG"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NFCReaderUsageDescription": "JosCity uses NFC only while you tap your CBrilliance card to pay for a marketplace order. The card tag is sent to JosCity to verify the payment. JosCity does not store your card number or PIN on this device.",
        "NSFaceIDUsageDescription": "JOSCITY uses Face ID so you can sign in without typing your password.",
        "NSMotionUsageDescription": "JOSCITY uses motion activity to improve your position on the Plateau map and show nearby places while you use the app.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePaymentInfo",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#0C3D26",
      "barStyle": "light-content",
      "translucent": true
    },
    "android": {
      "package": "com.joscity.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C3D26"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#0C3D26",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "JOSCITY uses Face ID so you can sign in without typing your password."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C3D26"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F3D26",
          "defaultChannel": "notifications",
          "enableBackgroundRemoteNotifications": true,
          "sounds": ["./assets/sounds/alarm.wav"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JOSCITY uses your photos so you can share photos, videos, and stories.",
          "cameraPermission": "JOSCITY uses the camera so you can take a photo or video.",
          "microphonePermission": "JOSCITY uses the microphone when you record a video for a post, story, or reel."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "JOSCITY needs access to save images to your photos.",
          "savePhotosPermission": "JOSCITY saves images you choose to keep.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-localization",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "JOSCITY uses the microphone when you record a video for a post, story, or reel.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "JosCity uses NFC only while you tap your CBrilliance card to pay for a marketplace order. The card tag is sent to JosCity to verify the payment. JosCity does not store your card number or PIN on this device.",
          "includeNdefEntitlement": false
        }
      ],
      "./plugins/withOptionalNfc.js",
      "./plugins/withNfcMainThread.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JosCity uses your location while you use the app to show your position and nearby places on the Plateau map.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "motionUsagePermission": "JOSCITY uses motion activity to improve your position on the Plateau map and show nearby places while you use the app.",
          "isAndroidMotionActivityEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f16400ee-dc08-4884-8022-d9fe6fb13027"
      }
    }
  }
}
