{
  "expo": {
    "name": "JosCity",
    "slug": "joscity",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "joscity",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C3D26"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joscity.app",
      "buildNumber": "2",
      "backgroundColor": "#0C3D26",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#0C3D26",
      "barStyle": "light-content",
      "translucent": true
    },
    "android": {
      "package": "com.joscity.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C3D26"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#0C3D26",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C3D26"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F3D26",
          "defaultChannel": "notifications",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JOSCITY uses your photos so you can share photos, videos, and stories.",
          "cameraPermission": "JOSCITY uses the camera so you can take a photo or video.",
          "microphonePermission": "JOSCITY uses the microphone when you record a video for a post, story, or reel."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "JOSCITY needs access to save images to your photos.",
          "savePhotosPermission": "JOSCITY saves images you choose to keep.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-localization",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "JOSCITY uses the microphone when you record a video for a post, story, or reel."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f16400ee-dc08-4884-8022-d9fe6fb13027"
      }
    }
  }
}
